# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migration: transient scrape output/logs, regenerate via find_new_candidates.mjs
migration/*.log
migration/new_candidates.json
migration/sitemap-cards-raw.xml
migration/sitemap-expansions-raw.xml
migration/sample_page.html
migration/yuyutei_*.html
migration/*_out.txt
migration/db_check.txt
