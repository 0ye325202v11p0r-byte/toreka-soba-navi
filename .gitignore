# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the checked-in template itself: SetupNotice.tsx and README.md
# both instruct a fresh setup to copy this file to .env.local, but the
# blanket `.env*` rule above silently excluded it too (no secrets in it —
# every value is a blank placeholder), so it was never actually committed.
# Found via self-review, 2026-09-12 — `git ls-files | grep env` returned
# nothing at all before this fix, meaning a clone of this repo had no way
# to follow that documented setup step.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migration: transient scrape output/logs, regenerate via find_new_candidates.mjs
migration/*.log
migration/new_candidates.json
migration/sitemap-cards-raw.xml
migration/sitemap-expansions-raw.xml
migration/sample_page.html
migration/yuyutei_*.html
migration/*_out.txt
migration/db_check.txt
