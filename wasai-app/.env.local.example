# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed for server-side scripts/cron that must bypass RLS.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute URLs (OGP, canonical, Stripe redirect/webhook
# targets). Set to the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Connect (エスクロー決済). Secret key from the Stripe Dashboard
# (test mode key while developing, e.g. sk_test_...).
STRIPE_SECRET_KEY=

# From the Stripe Dashboard > Developers > Webhooks, after registering
# https://<your-domain>/api/webhooks/stripe (events: checkout.session.completed,
# account.updated). For local development, use `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` and paste the signing secret it prints.
STRIPE_WEBHOOK_SECRET=

# Any random string — checked against the Authorization: Bearer header on
# /api/cron/* routes (Vercel Cron sends this automatically once set as a
# Vercel project env var; for a manual/local test, pass it yourself).
CRON_SECRET=
