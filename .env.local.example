# Phase 1 — Supabase（このファイルを .env.local にコピーして値を埋めてください）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用・絶対にNEXT_PUBLIC_を付けない・migration/migrate.mjsとcronでのみ使用
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 — 価格自動更新クロンの認証用（自分でランダムな文字列を生成してください）
CRON_SECRET=

# /admin/sync-status を見られる唯一のメールアドレス（未設定だと本人含め誰も見られません — src/lib/adminAuth.ts参照）
ADMIN_EMAIL=

# Phase 3 — Stripe（このフェーズに入ってから設定）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Phase 4 — Resend（このフェーズに入ってから設定）
RESEND_API_KEY=

# ブラウザのプッシュ通知（ウォッチリスト条件成立時）— 外部アカウント登録不要。
# ローカルで生成: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PRIVATE_KEYは絶対にNEXT_PUBLIC_を付けない（サーバー/cron専用）。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# CAPTCHA（ログイン・新規登録・パスワード再設定フォーム）— 未設定時は
# ウィジェット自体が表示されず、既存の挙動と完全に同じ（グレースフル
# デグレード）。有効化にはCloudflareアカウント（無料）でTurnstileの
# サイトを作成し、そのSite KeyをここNEXT_PUBLIC_TURNSTILE_SITE_KEYに、
# Secret KeyをSupabaseダッシュボードのAuthentication→Attack Protection
# に設定する必要がある（詳細はmigration/PRODUCTION_SETUP_CHECKLIST.md参照）。
# ローカル動作確認だけなら、Cloudflareが公開しているアカウント登録不要の
# テスト用キー（常に成功: 1x00000000000000000000AA）が使える。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
